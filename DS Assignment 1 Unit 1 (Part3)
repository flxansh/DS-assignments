#include<iostream>
using namespace std;
int main()
{
    int book[5];
    int temp;

    cout<<"Please Enter 5 Book ID: ";

    for(int i=0; i<5 ; i++)
        {
            cin>>book[i];
        }

    for(int i=0; i<4 ; i++)
        {
            for(int j=0; j<4-i ; j++)
                {
                    if(book[j]>book[j+1])
                    {
                        temp = book[j];
                        book[j]= book[j+1];
                        book[j+1]= temp;
                    }
                }
        }
    cout<<"\nBook IDs in Sorted form: "<<endl;
    for(int i=0 ; i<5 ; i++)
        {
            cout<<book[i]<<" ";
        }
    return 0;
}
