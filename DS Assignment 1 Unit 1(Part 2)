#include<iostream>
using namespace std;
int main()
{
    int Book[5];
    int searchid;
    cout<<"Please Enter 5 Book IDs: \n"<<endl;

    for(int i =0 ; i<5 ; i++)
        {
        cin>>Book[i];
        }
    cout<<"Please Enter Book ID To Search: "<<endl;
    cin>>searchid;

    for(int i=0 ; i<5 ; i++)
        {
        if(Book[i] == searchid)
        {
            cout<<"Book Found!!"<< endl;
            return 0;
        }
        }
    cout<<"Book Not Found..."<<endl;
    return 0;
}
